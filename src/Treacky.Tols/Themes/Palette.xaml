<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Treacky.Tols — Modern Dark Blue palette. -->
    <Color x:Key="C.Ink">#090C12</Color>
    <Color x:Key="C.Ink2">#0D1118</Color>
    <Color x:Key="C.Surface">#111722</Color>
    <Color x:Key="C.Surface2">#161D29</Color>
    <Color x:Key="C.Surface3">#1B2432</Color>
    <Color x:Key="C.Hairline">#293447</Color>
    <Color x:Key="C.HairlineSoft">#202938</Color>
    <Color x:Key="C.Text">#F0F5FC</Color>
    <Color x:Key="C.Muted">#9BA7B9</Color>
    <Color x:Key="C.Dim">#69778A</Color>
    <Color x:Key="C.ChromeHi">#F7FAFF</Color>
    <Color x:Key="C.ChromeMid">#D7E4F7</Color>
    <Color x:Key="C.ChromeLo">#78A9E8</Color>
    <Color x:Key="C.Ok">#78C7A3</Color>
    <Color x:Key="C.Warn">#D2A66F</Color>
    <Color x:Key="C.Info">#68A6F3</Color>

    <SolidColorBrush x:Key="B.Ink" Color="{StaticResource C.Ink}" />
    <SolidColorBrush x:Key="B.Ink2" Color="{StaticResource C.Ink2}" />
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="B.Surface2" Color="{StaticResource C.Surface2}" />
    <SolidColorBrush x:Key="B.Surface3" Color="{StaticResource C.Surface3}" />
    <SolidColorBrush x:Key="B.Hairline" Color="{StaticResource C.Hairline}" />
    <SolidColorBrush x:Key="B.HairlineSoft" Color="{StaticResource C.HairlineSoft}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.Muted" Color="{StaticResource C.Muted}" />
    <SolidColorBrush x:Key="B.Dim" Color="{StaticResource C.Dim}" />
    <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}" />
    <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="B.Info" Color="{StaticResource C.Info}" />

    <LinearGradientBrush x:Key="B.Chrome" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8FC1FF" Offset="0" />
        <GradientStop Color="#4D93F5" Offset="0.34" />
        <GradientStop Color="#397AD1" Offset="0.62" />
        <GradientStop Color="#69A8FA" Offset="0.84" />
        <GradientStop Color="#2F6BB8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.ChromeLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#243552" Offset="0" />
        <GradientStop Color="#4E7FB5" Offset="0.18" />
        <GradientStop Color="#26364F" Offset="0.55" />
        <GradientStop Color="#3D668F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.Card" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#151C28" Offset="0" />
        <GradientStop Color="#111822" Offset="0.55" />
        <GradientStop Color="#0E141E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.CardRaised" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A2331" Offset="0" />
        <GradientStop Color="#131A25" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.Sidebar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0B1017" Offset="0" />
        <GradientStop Color="#090D13" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.FadeLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#37557A" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="B.Vignette" Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.85" RadiusY="0.85">
        <GradientStop Color="#1A2A40" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

</ResourceDictionary>
